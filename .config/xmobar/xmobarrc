Config { font = "JetBrains Mono Nerd Font 15"
       , additionalFonts = [ "Mononoki Nerd Font 15"
                           , "Font Awesome 5 Free Solid 15"
                           , "Font Awesome 5 Brands 15"
                           ]
       , borderColor = "black"
       , border = TopB
       , bgColor = "black"
       , fgColor = "grey"
       , alpha = 255
       , position = TopH 35
       , textOffset = -1
       , iconOffset = -1
       , lowerOnStart = True
       , pickBroadest = False
       , persistent = False
       , hideOnStart = False
       , allDesktops = True
       , overrideRedirect = True
       , iconRoot = ".xmonad/xpm/"
       , commands = [Run Cpu ["-t", "CPU: <total>%"] 10
                    , Run Network "__ETH__" ["-t", "<fn=2>\xf6ff</fn> <fn=2>\xf063</fn> <rx>Kb <fn=2>\xf062</fn> <tx>Kb", "-S", "N/A"] 10
                    , Run Network "__WIFI__" ["-t", "<rx>Kb|<tx>Kb"] 10
                    , Run Wireless "__WIFI__" ["-t","<fn=2>\xf1eb</fn> <essid> <quality>"] 10
                    , Run Memory ["-t","RAM: <usedratio>%"] 10
                    , Run Swap ["-t","SWAP: <usedratio>%"] 100
                    , Run Date "<fn=2>\xf017</fn> %a %b %_d %Y %H:%M:%S" "date" 10
                    , Run Com "xkblayout-state" ["print", "<fn=2>\xf0ac</fn> %s"] "layout" 10
                    , Run Com "/bin/bash" ["-c", "echo \"<fn=2>\xf028</fn> $(~/scripts/get-volume.sh)\""] "myvolume" 10
                    , Run Com "/bin/bash" ["-c", "~/scripts/charge-status.sh"] "battery" 600
                    , Run Com "/bin/bash" ["-c", "~/scripts/vpn.sh | xargs echo '<fn=2>\xf3ed</fn>'"] "vpn" 10
                    , Run Com "/bin/bash" ["-c", "playerctl metadata 2>/dev/null --format '<fn=2>\xf001</fn> {{ artist }} - {{ title }}' | awk '{print substr($0,1,50)}'"] "music" 10
                    , Run Com "/bin/bash" ["-c", "echo '<fn=2>\xf35b</fn>' $(apt list -q --upgradable 2>/dev/null | grep -v 'Listing...' | wc -l)"] "upd" 600
                    , Run Com "/bin/bash" ["-c", "d=$(~/scripts/blue-connected.sh); echo \"__BOX__<fn=2>\xf3fa</fn>${d:+ $d}__XOB__\""] "blue" 10
                    , Run Com "/bin/bash" ["-c", "echo \"<fn=2>\xf0a0</fn> $(~/scripts/disk-usage.sh)\""] "disk" 100
                    , Run Com "/bin/bash" ["-c", "b=$(~/scripts/brightness.sh); echo \"__BOX__<fn=2>\xf185</fn>${b:+ $b}__XOB__\""] "bright" 60
                    , Run StdinReader
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "__BOX__%cpu%__XOB__ \
                    \ __BOX__%memory%__XOB__ \
                    \ __BOX__%swap%__XOB__ \
                    \ __BOX__%disk%__XOB__ \
                    \ __BOX__%__ETH__%__XOB__ \
                    \ __BOX__%__WIFI__wi% %__WIFI__%__XOB__ \
                    \ __BOX__%vpn%__XOB__ \
                    \ %blue% \
                    \ __BOX__%upd%__XOB__ } \
                    \ %StdinReader% \
                    \{__BOX__%music%__XOB__ \
                    \ __BOX__%date%__XOB__ \
                    \ __BOX__%layout%__XOB__ \
                    \ __BOX__%myvolume%__XOB__ \
                    \ %bright% \
                    \ __BOX__%battery%__XOB__ "
       }
